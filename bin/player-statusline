#!/usr/bin/env bash
# One-line player status for the Claude Code status line.
# Reads the statusLine JSON on stdin and appends the current Apple Music track (cassette style).
set -uo pipefail
input="$(cat)"
model="$(printf '%s' "$input" | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("model",{}).get("display_name",""))
except Exception: print("")' 2>/dev/null)"
j="$("$(dirname "$0")/player" status 2>/dev/null)"
tape="$(python3 - "$j" <<'PY'
import json, sys
try: d = json.loads(sys.argv[1])
except Exception: d = {}
st = d.get("state", "stopped")
if "title" not in d:
    print("🎵 ■"); sys.exit()
i = {"playing": "▶", "paused": "‖"}.get(st, "■")
def mmss(s):
    s = int(s); return f"{s//60}:{s%60:02d}"
# Same shape as the band's own hidden-state row (statusLineOf in
# hooks/register.tsx): a short meter as well as the clock, and no dangling
# separator when the CLI reports no artist.
pos, dur = d.get("position", 0), d.get("duration", 0)
name = " · ".join(x for x in (d.get("title"), d.get("artist")) if x)
w = 8
filled = max(0, min(w, round(w * pos / dur))) if dur else 0
meter = "█" * filled + "░" * (w - filled)
print(f"🎵 {i} {name}  {meter} {mmss(pos)}/{mmss(dur)}")
PY
)"
printf '%s%s\n' "${model:+$model  }" "$tape"

#!/usr/bin/env python3
"""player-art — the current track's artwork, packed as terminal Raster cells.

Music.app hands `raw data of artwork 1 of current track` over AppleScript; sips
downscales it to a tiny BMP (the one image format with a header we can parse in
a few lines of stdlib); each terminal cell then carries a 2x2 pixel block drawn
with a quadrant block glyph, so a cell is four pixels rather than the two an
upper-half block would hold.

Prints one JSON object: {"columns", "rows", "cells"} where `cells` is base64 of
little-endian u32 triplets [codePoint, fg, bg], the shape a Raster element
wants. Prints {"columns":0,...} when Music is idle or the track has no artwork.

The export costs a second or so, so it is cached under the track's identity
(persistent ID, else title+album): the band's one-second poll re-reads the
cache instead of re-exporting.
"""
import base64
import hashlib
import json
import os
import struct
import subprocess
import sys
import tempfile

CACHE = os.path.join(tempfile.gettempdir(), "player-art-cache")

# How much taller than wide one drawn Raster cell is: an image this many times
# wider than tall reads square on screen.
#
# Measured off a screenshot rather than reasoned about, because the earlier
# value (4.9) assumed the surface draws a block cell over two screen rows on
# top of the grid's own 2.47 ratio, and a 20x4 cover then came out visibly
# squashed — 175 x 95 px, where square would be 1:1. That works out to 8.75 px
# per cell column against 23.75 px per Raster row, so the real ratio is ~2.7
# and the doubling was already counted in the grid figure.
#
# This is per-terminal: it moves with the font and with settings like Ghostty's
# `adjust-cell-height`. Re-measure and change this one number if a cover ever
# looks stretched — screenshot a cover, divide its width by its height, and
# multiply this value by that.
CELL_ASPECT = 2.7

# Quadrant blocks indexed by a 4-bit mask of which pixels are the bright group:
# bit 0 top-left, 1 top-right, 2 bottom-left, 3 bottom-right. Mask 0 never
# reaches here (a flat block becomes one full block instead), and mask 15 is the
# full block itself. U+2580 and U+2588 fill the gaps the quadrant range leaves.
QUADRANTS = [
    0x0020,  # 0000 (unused: a flat block is emitted as a full block)
    0x2598,  # 0001 ▘
    0x259D,  # 0010 ▝
    0x2580,  # 0011 ▀
    0x2596,  # 0100 ▖
    0x258C,  # 0101 ▌
    0x259E,  # 0110 ▞
    0x259B,  # 0111 ▛
    0x2597,  # 1000 ▗
    0x259A,  # 1001 ▚
    0x2590,  # 1010 ▐
    0x259C,  # 1011 ▜
    0x2584,  # 1100 ▄
    0x2599,  # 1101 ▙
    0x259F,  # 1110 ▟
    0x2588,  # 1111 █
]

# Identity and artwork in one AppleScript round trip. The raw data goes to a
# file because a few hundred KB of hex through stdout is slower than a write.
EXPORT = r'''
on run argv
  set outPath to item 1 of argv
  tell application "Music"
    if player state is stopped then return "IDLE"
    try
      set t to current track
    on error
      return "IDLE"
    end try
    set ident to ""
    try
      set ident to (persistent ID of t) as text
    end try
    if ident is "" then
      try
        set ident to (name of t as text) & "|" & (album of t as text)
      end try
    end if
    try
      set d to raw data of artwork 1 of t
    on error
      return "NOART	" & ident
    end try
  end tell
  set f to open for access (POSIX file outPath) with write permission
  set eof f to 0
  write d to f
  close access f
  return "OK	" & ident
end run
'''

IDENTITY = r'''
tell application "Music"
  if player state is stopped then return "IDLE"
  try
    set t to current track
  on error
    return "IDLE"
  end try
  try
    return (persistent ID of t) as text
  end try
  try
    return (name of t as text) & "|" & (album of t as text)
  end try
  return "IDLE"
end tell
'''


def osa(script, *args):
    r = subprocess.run(
        ["osascript", "-", *args], input=script, capture_output=True, text=True
    )
    return r.stdout.strip()


def pack(bmp_path):
    """Read a 24-bit BMP and pack it as quadrant Raster cells.

    A cell draws two colours at most, so its four pixels are split by luminance
    into a bright group and a dark one: the glyph's set quadrants are the bright
    pixels (fg = their mean), the rest the dark (bg = their mean). A block whose
    pixels are all one shade degrades to a full block in that colour.
    """
    d = open(bmp_path, "rb").read()
    off = struct.unpack_from("<I", d, 10)[0]
    w = struct.unpack_from("<i", d, 18)[0]
    h = struct.unpack_from("<i", d, 22)[0]
    bpp = struct.unpack_from("<H", d, 28)[0]
    if bpp != 24:
        raise ValueError("expected a 24-bit BMP, got %d-bit" % bpp)
    top_down = h < 0
    height = abs(h)
    stride = ((w * bpp // 8) + 3) // 4 * 4

    def px(x, y):
        row = y if top_down else height - 1 - y
        i = off + row * stride + x * 3
        return (d[i + 2], d[i + 1], d[i])

    def mean(pixels):
        n = len(pixels)
        return ((sum(p[0] for p in pixels) // n) << 16 |
                (sum(p[1] for p in pixels) // n) << 8 |
                (sum(p[2] for p in pixels) // n))

    words = []
    for ry in range(0, height - 1, 2):
        for x in range(0, w - 1, 2):
            quad = [px(x, ry), px(x + 1, ry), px(x, ry + 1), px(x + 1, ry + 1)]
            lum = [0.299 * p[0] + 0.587 * p[1] + 0.114 * p[2] for p in quad]
            mid = (min(lum) + max(lum)) / 2
            mask, bright, dark = 0, [], []
            for i, (p, l) in enumerate(zip(quad, lum)):
                if l > mid:
                    mask |= 1 << i
                    bright.append(p)
                else:
                    dark.append(p)
            if not bright:  # every pixel the same shade: one flat full block
                words += [0x2588, mean(dark), 0]
            else:
                words += [QUADRANTS[mask], mean(bright), mean(dark)]
    cells = base64.b64encode(struct.pack("<%dI" % len(words), *words)).decode()
    return {"columns": w // 2, "rows": height // 2, "cells": cells}


def main():
    size = int(sys.argv[1]) if len(sys.argv) > 1 else 12
    empty = {"columns": 0, "rows": 0, "cells": ""}

    ident = osa(IDENTITY)
    if ident in ("", "IDLE"):
        print(json.dumps(empty))
        return

    key = hashlib.sha1(("%s@%d" % (ident, size)).encode()).hexdigest()[:16]
    cached = os.path.join(CACHE, key + ".json")
    if os.path.exists(cached):
        sys.stdout.write(open(cached).read())
        return

    os.makedirs(CACHE, exist_ok=True)
    with tempfile.TemporaryDirectory() as tmp:
        raw = os.path.join(tmp, "art.png")
        head = osa(EXPORT, raw)
        if not head.startswith("OK") or not os.path.exists(raw):
            print(json.dumps(empty))
            return
        bmp = os.path.join(tmp, "art.bmp")
        # `size` is the width in columns, so the image is 2*size pixels across.
        # Its height is that divided by CELL_ASPECT, which keeps the cover
        # square on screen (see the constant); rounded to an even number of
        # pixels so it packs into whole rows.
        px_w = size * 2
        px_h = max(2, int(round(px_w / CELL_ASPECT / 2)) * 2)
        r = subprocess.run(
            ["sips", "-z", str(px_h), str(px_w), "-s", "format", "bmp",
             raw, "--out", bmp],
            capture_output=True, text=True,
        )
        if r.returncode != 0 or not os.path.exists(bmp):
            print(json.dumps(empty))
            return
        try:
            out = json.dumps(pack(bmp))
        except Exception:
            print(json.dumps(empty))
            return

    try:
        with open(cached, "w") as f:
            f.write(out)
    except OSError:
        pass
    print(out)


if __name__ == "__main__":
    main()
